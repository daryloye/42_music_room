#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
before=$(mktemp)
after=$(mktemp)
trap 'rm -f "$before" "$after"' EXIT HUP INT TERM

cd "$repo_root"

git diff --binary -- backend >"$before"
make format
git diff --binary -- backend >"$after"

if ! cmp -s "$before" "$after"; then
	echo "Formatting updated these files:"
	git diff --name-only -- backend
	echo "Review and stage the formatting changes, then commit again."
	exit 1
fi

make format-check
